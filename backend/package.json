{
  "name": "lg-ac-diagnostic-backend",
  "version": "1.0.0",
  "description": "LG AC Diagnostic Support API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/db/seed.ts",
    "ingest": "ts-node src/scripts/ingest-documents.ts",
    "test": "ts-node src/scripts/audit-test-runner.ts",
    "test:booking": "ts-node src/tests/conversationalBooking.test.ts",
    "test:voice:noise": "ts-node src/tests/voice/noiseRobustVoice.test.ts",
    "test:voice:suite": "ts-node src/tests/voice/runAllVoiceTests.ts",
    "test:voice": "ts-node src/scripts/voice-pipeline-test.ts",
    "benchmark:lid": "ts-node benchmark/scripts/run_benchmark.ts",
    "benchmark:lid:testc": "ts-node benchmark/scripts/run_benchmark.ts --test-c",
    "benchmark:manifest": "ts-node benchmark/scripts/build_manifest.ts",
    "benchmark:dry-run": "ts-node benchmark/scripts/run_benchmark.ts --dry-run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "uuid": "^10.0.0",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}